# ==========================================
# minIoT Platform Environment Configuration
# ==========================================

# Environment mode
APP_ENV=development

# Infrastructure - PostgreSQL / TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=miniot
DB_SSLMODE=disable

# Infrastructure - pgAdmin 4 (PostgreSQL Web Admin)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@miniot.io
PGADMIN_DEFAULT_PASSWORD=admin

# Infrastructure - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Infrastructure - EMQX MQTT Broker
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_SSL_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASS=public

# Security & Secrets
JWT_SECRET=miniot_super_secret_jwt_key_change_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=1m

# Apps - API Service
API_PORT=8080
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# Apps - Ingestor Service
INGESTOR_MQTT_CLIENT_ID=miniot-ingestor-01
INGESTOR_MQTT_TOPIC=devices/+/telemetry
HEALTH_PORT=8081
EMQX_USE_TLS=false
EMQX_TLS_SKIP_VERIFY=true

# Apps - Web Frontend
WEB_PORT=4200
API_BASE_URL=http://localhost:8080/api/v1

